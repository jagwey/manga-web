[Unit]
Description=Kage 95 Manga API Service (.NET 10)
After=network.target

[Service]
WorkingDirectory=/var/www/kage95/backend
ExecStart=/usr/bin/dotnet /var/www/kage95/backend/backend.dll
Restart=always
# Çökme durumunda 10 sn sonra yeniden başlat
RestartSec=10
KillSignal=SIGINT
SyslogIdentifier=kage95-api
User=www-data
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=DOTNET_PRINT_TELEMETRY_MESSAGE=false
Environment=ASPNETCORE_URLS=http://127.0.0.1:5035

[Install]
WantedBy=multi-user.target
